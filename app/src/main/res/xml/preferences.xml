<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/pref_category_appearance_title"
        app:useMaterialThemeColors="true">

        <Preference
            android:key="@string/pref_theme"
            android:title="@string/pref_title_theme"
            android:summary="@string/pref_summary_theme"
            app:useMaterialThemeColors="true"
            android:icon="@drawable/ic_day_night" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/pref_dynamic_colors"
            android:title="@string/pref_title_dynamic_colors"
            android:summary="@string/pref_summary_dynamic_colors"
            app:useMaterialThemeColors="true"
            android:icon="@drawable/ic_dynamic_color" />

        <Preference
            android:key="@string/pref_seed_color"
            android:title="@string/pref_title_seed_color"
            android:summary="@string/pref_summary_seed_color"
            app:useMaterialThemeColors="true"
            android:icon="@drawable/ic_color" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="@string/pref_category_app_behavior_key"
        android:title="@string/pref_category_app_behavior_title"
        app:useMaterialThemeColors="true">

        <SwitchPreferenceCompat
            android:defaultValue="@bool/pref_show_system_default"
            android:key="@string/pref_show_system"
            android:summary="@string/pref_summary_show_system"
            android:title="@string/pref_title_show_system"
            app:useMaterialThemeColors="true"
            android:icon="@drawable/ic_show_system" />
            
        <Preference
            android:key="@string/pref_sort_order"
            android:summary="@string/pref_summary_sort_order"
            android:title="@string/pref_title_sort_order"
            app:useMaterialThemeColors="true"
            android:icon="@drawable/ic_sort_order" />
            
    </PreferenceCategory>

    <!--
        Content the viewer chooses not to see. Unlike every other block
        here the value lives on the server, so these switches are not
        persistent: they are painted from the profile and written back to
        it. The categories themselves are not declared here either: the
        server sends the list, worded, and the rows are built from it —
        so only the family-friendly row, which stands for the whole list
        rather than any one category, is spelled out below. The switches
        say what is *shown*, matching the website, and the summaries name
        the resulting state so neither position can be read the wrong way
        round.
    -->
    <PreferenceCategory
        android:title="@string/pref_category_content_title"
        app:useMaterialThemeColors="true">

        <PreferenceScreen
            android:key="@string/pref_content_filter_key"
            android:title="@string/pref_title_content_filter"
            android:summary="@string/pref_summary_content_nothing_hidden"
            app:useMaterialThemeColors="true"
            android:icon="@drawable/ic_content_filter">

            <PreferenceCategory
                android:key="@string/pref_content_filter_group_key"
                android:title="@string/pref_content_filter_header"
                app:useMaterialThemeColors="true">

                <SwitchPreferenceCompat
                    android:key="@string/pref_family_friendly"
                    android:persistent="false"
                    android:summary="@string/pref_summary_family_friendly"
                    android:title="@string/pref_title_family_friendly"
                    app:useMaterialThemeColors="true" />

            </PreferenceCategory>

        </PreferenceScreen>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_category_network_title"
        app:useMaterialThemeColors="true">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/pref_proxy_enabled"
            android:title="@string/pref_title_proxy_enabled"
            android:summary="@string/pref_summary_proxy_enabled"
            app:useMaterialThemeColors="true"
            android:icon="@drawable/ic_proxy" />

        <Preference
            android:key="@string/pref_proxy_settings"
            android:title="@string/pref_title_proxy_settings"
            android:summary="@string/pref_summary_proxy_settings"
            android:dependency="@string/pref_proxy_enabled"
            app:useMaterialThemeColors="true"
            android:icon="@drawable/ic_proxy_settings" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_category_general_title"
        app:useMaterialThemeColors="true">
        
        <Preference
            android:key="@string/pref_clear_cache"
            android:summary="@string/pref_summary_clear_cache"
            android:title="@string/pref_title_clear_cache"
            app:useMaterialThemeColors="true"
            android:icon="@drawable/ic_clear_cache" />
            
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
