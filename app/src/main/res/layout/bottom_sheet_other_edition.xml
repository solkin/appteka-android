<?xml version="1.0" encoding="utf-8"?>
<!--
  Details of a newer build from another publisher, opened from the
  installed app's actions. It is never an update: it carries another
  signing key, so Android installs it only after the app is removed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingLeft="24dp"
        android:paddingEnd="24dp"
        android:paddingRight="24dp"
        android:paddingTop="4dp"
        android:text="@string/other_edition_hint"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?text_primary_color" />

    <TextView
        android:id="@+id/other_edition_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingLeft="24dp"
        android:paddingEnd="24dp"
        android:paddingRight="24dp"
        android:paddingTop="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?text_secondary_color"
        tools:text="Version 2.4, published 06.11.26" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingLeft="24dp"
        android:paddingEnd="24dp"
        android:paddingRight="24dp"
        android:paddingTop="12dp"
        android:text="@string/other_edition_reinstall"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?text_primary_color" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingLeft="16dp"
        android:paddingEnd="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/other_edition_open"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/other_edition_open" />

    </LinearLayout>

</LinearLayout>
