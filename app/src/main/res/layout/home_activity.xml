<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:liftOnScrollTargetViewId="@id/recycler">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/AppTheme.PopupOverlay" />

        <!--
            Store filters. Per-tab chrome on a shared app bar, the same
            way the toolbar's title and menu are swapped — HomeView
            shows this row for the store tab and hides it for the rest.
            It belongs in the bar rather than at the top of the list so
            it takes the lifted colour along with it, and so the filters
            stay reachable however far the catalog is scrolled.
        -->
        <HorizontalScrollView
            android:id="@+id/store_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="4dp"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_category"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/all_categories"
                    app:chipIcon="@drawable/ic_category"
                    app:chipIconTint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_open_source"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/open_source_short" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_exclusive"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/exclusive_short" />

                <!--
                    Not a filter of this screen: it reports the account's
                    own content setting, which is why it is an assist chip
                    among filter chips and leads to settings rather than
                    toggling anything here. Hidden unless something is
                    actually being withheld.
                -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_content_filter"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:chipIcon="@drawable/ic_content_filter"
                    app:chipIconTint="?attr/colorOnSurfaceVariant"
                    tools:text="Hidden: 18+"
                    tools:visibility="visible" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <include
            android:id="@+id/update_block"
            layout="@layout/update_block"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_upload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="96dp"
        android:src="@drawable/ic_cloud_upload"
        app:elevation="3dp"
        app:fabSize="normal"
        app:pressedTranslationZ="6dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="96dp"
        android:src="@drawable/ic_pencil"
        app:elevation="3dp"
        app:fabSize="normal"
        app:pressedTranslationZ="6dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_create_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="96dp"
        android:contentDescription="@string/create_chat_title"
        android:src="@drawable/ic_baseline_add_24"
        app:elevation="3dp"
        app:fabSize="normal"
        app:pressedTranslationZ="6dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
