<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/reviews_scope_group"
        style="?attr/materialButtonToggleGroupStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:selectionRequired="true"
        app:singleSelection="true"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scope_edition"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:maxLines="1"
            android:minHeight="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/reviews_scope_all"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scope_build"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:maxLines="1"
            android:minHeight="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="13sp"
            tools:text="Version 2.0" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout
        android:id="@+id/scores_summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/rating_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:padding="4dp"
            android:paddingTop="4dp"
            android:textAllCaps="true"
            android:textColor="?text_primary_color"
            android:textSize="48sp"
            tools:text="4.7" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="0dp">

            <me.zhanghai.android.materialratingbar.MaterialRatingBar
                android:id="@+id/small_rating_indicator"
                style="@style/Widget.MaterialRatingBar.RatingBar"
                android:layout_width="90dp"
                android:layout_height="18dp"
                android:layout_marginBottom="2dp"
                android:isIndicator="true"
                android:numStars="5"
                android:progressBackgroundTint="?rating_empty"
                android:progressDrawable="@drawable/rating_bar_small"
                android:progressTint="?rating_fill"
                android:rating="0"
                android:secondaryProgressTint="?rating_empty"
                android:stepSize="0.5"
                app:mrb_fillBackgroundStars="true"
                tools:rating="3.5" />

            <TextView
                android:id="@+id/rates_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/small_rating_indicator"
                android:textColor="?text_secondary_color"
                android:textSize="14sp"
                tools:text="15" />

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_alignTop="@+id/rates_count"
                android:layout_toEndOf="@id/rates_count"
                android:contentDescription="@string/rates_count"
                android:src="@drawable/ic_account"
                app:tint="?text_secondary_color" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="0dp">

            <ProgressBar
                android:id="@+id/rating_detail_element_five"
                style="@style/RatingDetailElementSmall"
                android:progressTint="?five_stars"
                tools:progress="80" />

            <ProgressBar
                android:id="@+id/rating_detail_element_four"
                style="@style/RatingDetailElementSmall"
                android:progressTint="?four_stars"
                tools:progress="15" />

            <ProgressBar
                android:id="@+id/rating_detail_element_three"
                style="@style/RatingDetailElementSmall"
                android:progressTint="?three_stars"
                tools:progress="7" />

            <ProgressBar
                android:id="@+id/rating_detail_element_two"
                style="@style/RatingDetailElementSmall"
                android:progressTint="?two_stars"
                tools:progress="3" />

            <ProgressBar
                android:id="@+id/rating_detail_element_one"
                style="@style/RatingDetailElementSmall"
                android:progressTint="?one_stars"
                tools:progress="10" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/scores_empty_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_reviews_for_build"
            android:textColor="?text_secondary_color"
            android:textSize="14sp" />

        <!--
            Negative margins cancel the button's own horizontal padding so the
            label starts on the same line as the text above.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/show_all_versions_button"
            style="@style/MaterialButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="-8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/show_all_versions" />

    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/reviews_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="24dp"
        app:trackThickness="2dp" />

    <LinearLayout
        android:id="@+id/reviews_error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/reviews_loading_error"
            android:textColor="?text_secondary_color"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviews_retry_button"
            style="@style/MaterialButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="-8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/retry" />

    </LinearLayout>

</LinearLayout>
